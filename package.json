{
  "name": "roku-game-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Roku game creation with native BrightScript simulator testing",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:visual": "node visual-editor/server.js",
    "check:runtime": "bsc --rootDir . --files source/**/*.brs --copyToStaging false --createPackage false",
    "simulator": "node visual-editor/simulator-server.js",
    "simulator:setup": "node visual-editor/setup-simulator.js",
    "test:browser": "node tools/check-engine.cjs",
    "test:browser-suite": "node tools/check-browser-suite.cjs",
    "test:ui": "node tools/check-engine.cjs --ui",
    "test:mol": "node tools/check-engine.cjs --mol",
    "test:ui-screens": "node tools/check-engine.cjs --mol-ui",
    "test:typography": "node tools/check-engine.cjs --typography",
    "test:scripts": "node tools/check-engine.cjs --mol-ui --scripts",
    "test:script-actions": "node tools/check-engine.cjs --script-actions",
    "test:slicing": "node tools/check-engine.cjs --slicing",
    "test:visual-browser": "node visual-editor/check-browser.js",
    "test": "node --test visual-editor/test/*.test.js export/test/*.test.cjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "brighterscript": "^0.73.8",
    "electron": "^45.2.1",
    "konva": "^9.3.22"
  }
}
